<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="greetingServiceBean1" class="com.example.GreetingService">
        <property name="message" value="Hello from Spring (Setter Injection)!"/>
    </bean>

    <bean id="greetingServiceBean2" class="com.example.GreetingService">
        <constructor-arg value="Hello from Spring (Constructor Injection)!"/>
    </bean>

</beans>